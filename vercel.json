{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    { "source": "/api/auth/manage-emails", "destination": "/api/auth/[action]?action=manage-emails" },
    { "source": "/api/auth/request-otp",   "destination": "/api/auth/[action]?action=request-otp" },
    { "source": "/api/auth/verify-otp",    "destination": "/api/auth/[action]?action=verify-otp" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/refresh-news",      "schedule": "30 3 * * *"   },
    { "path": "/api/cron/deadline-alerts",   "schedule": "30 2 * * *"   }
  ]
}
